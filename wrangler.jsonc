{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // Only reachable through the custom domain below; no *.workers.dev / preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mail-worker",
      "database_id": "06e60b1e-b056-4a77-8abd-401c7f2505bc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mail-worker" }],
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "Realtime" }] },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Realtime"] }],
  // Every 10 min: retry failed parses. Hourly: retention cleanup.
  "triggers": { "crons": ["*/10 * * * *", "7 * * * *"] },
  "vars": {
    "WORKER_NAME": "mail-worker",
    "PUBLIC_URL": "https://mail.yorhamc.com",
    // ~3ms CPU; fits the Free plan's 10ms budget. Raise to 100000 on Workers Paid.
    "PASSWORD_HASH_ITERATIONS": "20000",
    "TRASH_RETENTION_DAYS": "30",
    "SPAM_RETENTION_DAYS": "30"
  },
  "observability": { "enabled": true },
  "dev": { "port": 8799 },
  "routes": [{ "pattern": "mail.yorhamc.com", "custom_domain": true }]
}
